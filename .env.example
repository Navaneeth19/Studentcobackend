PORT=5001
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# ── OTP (email verification / forgot password / passwordless) ──
# Codes are 6-digit, 10-min TTL, 30s resend cooldown, 5/hour/email, 5 attempts.
# OTP_TTL_MS=600000
# OTP_DEBUG_RETURN=true  # return { debugCode } outside production for testing
# ── Email sending: EmailJS (preferred) or SMTP ──
# Priority: EmailJS → SMTP → console log + { debugCode }.
# EMAILJS: dashboard → Service (ID) + Email Templates (ID) + Account → API keys.
# The template's "To Email" field must be {{to_email}} and use {{code}},
# {{subject}}, {{message}} in the subject/body. Server sends need the Private Key too.
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
# EMAILJS_TO_FIELD=to_email
# EMAILJS_CODE_FIELD=code
# --- or SMTP (e.g. Lark Mail) ---
# Real emails via SMTP (nodemailer is installed).
# Without these the OTP code is only logged to the console + returned as debugCode.
# Gmail: host smtp.gmail.com, port 587, user = your gmail, pass = App Password (Google Account → 2FA → App passwords).
# Brevo/SendGrid: use the host/user/pass they give you.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=StudentCo <you@gmail.com>
# NODE_ENV=development  # set to production to hide { debugCode } from API responses

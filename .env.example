PORT=5001
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# ── OTP (email verification / forgot password / passwordless) ──
# Codes are 6-digit, 10-min TTL, 30s resend cooldown, 5/hour/email, 5 attempts.
# OTP_TTL_MS=600000
# OTP_DEBUG_RETURN=true  # return { debugCode } outside production for testing
# Optional SMTP for real emails (needs `npm i nodemailer`).
# Without SMTP the code is logged to the console (dev works with no setup).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=StudentCo <no-reply@studentco.app>
